{
  "env": {
    "node": true,
    "mocha": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "plugins": ["import"],
  "rules": {
    "no-alert": 0,
    "no-console": 0,
    "object-curly-spacing": 0,
    "object-curly-newline": 0,
    "import/prefer-default-export": 0,
    "import/no-duplicates": 1,
    "arrow-body-style": 0,
    "no-underscore-dangle": 0,
    "global-require": 0,
    "semi-style": 0
  }
}
