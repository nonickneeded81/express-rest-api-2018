{
  "name": "express-rest-api-2018",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "echo 'No build step required - native ESM'",
    "start:dev": "NODE_ENV=development node src/index.js",
    "start:stg": "NODE_ENV=staging node src/index.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "docker:build": "docker-compose build",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:stg": "docker-compose -f docker-compose.yml -f docker-compose.stg.yml up",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "db": "sequelize --config config/db.cjs",
    "db:migrate": "npm run db -- db:migrate",
    "test": "npm run test:lint && npm run test:unit",
    "test:unit": "NODE_ENV=test mocha --timeout 20000 --exit 'src/**/*.spec.js'",
    "test:unit:target": "npm run mocha",
    "test:lint": "eslint ./src/",
    "mocha": "NODE_ENV=test mocha --timeout 20000 --exit"
  },
  "devDependencies": {
    "@eslint/js": "^9.x",
    "chai": "^4.x",
    "eslint": "^9.x",
    "globals": "^15.x",
    "mocha": "^10.x",
    "nodemon": "^3.x",
    "supertest": "^6.x"
  },
  "dependencies": {
    "dotenv": "^16.x",
    "express": "^4.21.x",
    "express-validator": "^7.x",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "mysql2": "^3.x",
    "sequelize": "^6.x",
    "sequelize-cli": "^6.x"
  }
}
