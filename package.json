{
  "name": "express-rest-api-2018",
  "main": "dist/index.js",
  "scripts": {
    "build": "babel src --out-dir dist/src --ignore spec.js && babel config --out-dir dist/config --copy-files",
    "start:dev": "NODE_ENV=development && yarn db:migrate && nodemon --exec npx babel-node src/index.js",
    "start:stg": "NODE_ENV=staging && yarn build && yarn db:migrate && node dist/src/index.js",
    "start:prod": "NODE_ENV=production && yarn build && yarn db:migrate && node dist/src/index.js",
    "docker:build": "docker-compose build",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:stg": "docker-compose -f docker-compose.yml -f docker-compose.stg.yml up",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "db": "sequelize --config config/db.js",
    "db:migrate": "yarn db db:migrate",
    "test": "yarn test:lint && yarn test:unit",
    "test:unit": "yarn mocha 'src/**/*.spec.js'",
    "test:unit:target": "yarn mocha",
    "test:lint": "eslint ./src/",
    "mocha": "NODE_ENV=test mocha --require @babel/register --timeout 20000 --exit"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.24.0",
    "@babel/node": "^7.24.0",
    "@babel/plugin-transform-class-properties": "^7.24.0",
    "@babel/plugin-transform-object-rest-spread": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-flow": "^7.24.0",
    "@babel/register": "^7.24.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.0"
  },
  "dependencies": {
    "body-parser": "^1.18.2",
    "dotenv": "^16.4.0",
    "express": "^4.16.2",
    "express-validator": "^7.0.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.0",
    "sequelize": "^6.37.0",
    "sequelize-cli": "^6.6.0"
  }
}
