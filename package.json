{
  "name": "express-rest-api-2018",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start:dev": "NODE_ENV=development node --watch src/index.js",
    "start:stg": "NODE_ENV=staging node src/index.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "docker:build": "docker-compose build",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:stg": "docker-compose -f docker-compose.yml -f docker-compose.stg.yml up",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "db": "sequelize-cli --config config/db.cjs",
    "db:migrate": "npx sequelize-cli db:migrate --config config/db.cjs",
    "test": "yarn test:lint && yarn test:unit",
    "test:unit": "mocha 'src/**/*.spec.js' --timeout 20000 --exit",
    "test:lint": "eslint ./src/"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "@eslint/js": "^8.56.0",
    "eslint-plugin-import": "^2.29.0",
    "mocha": "^10.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.0"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.0",
    "sequelize": "^6.37.0",
    "sequelize-cli": "^6.6.0"
  }
}
