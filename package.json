{
  "name": "express-rest-api-2018",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "yarn flow:install:typed",
    "build": "babel src --out-dir dist/src --ignore '**/*.spec.js' && babel config --out-dir dist/config --copy-files",
    "start:dev": "NODE_ENV=development && yarn db:migrate && nodemon --exec @babel/node src/index.js",
    "start:stg": "NODE_ENV=staging && yarn build && yarn db:migrate && @babel/node dist/src/index.js",
    "start:prod": "NODE_ENV=production && yarn build && yarn db:migrate && @babel/node dist/src/index.js",
    "docker:build": "docker-compose build",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:stg": "docker-compose -f docker-compose.yml -f docker-compose.stg.yml up",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "db": "sequelize --config config/db.js",
    "db:migrate": "yarn db db:migrate",
    "flow": "flow",
    "flow:install:typed": "flow-typed install",
    "test": "yarn test:lint && yarn test:unit",
    "test:unit": "yarn mocha 'src/**/*.spec.js'",
    "test:unit:target": "yarn mocha",
    "test:lint": "eslint ./src/",
    "mocha": "NODE_ENV=test mocha --require @babel/register --timeout 20000 --exit"
  },
  "devDependencies": {
    "@babel/cli": "^7.x",
    "@babel/core": "^7.x",
    "@babel/eslint-parser": "^7.x",
    "@babel/node": "^7.x",
    "@babel/plugin-proposal-class-properties": "^7.x",
    "@babel/plugin-proposal-object-rest-spread": "^7.x",
    "@babel/preset-env": "^7.x",
    "@babel/preset-flow": "^7.x",
    "@babel/register": "^7.x",
    "core-js": "^3.x",
    "regenerator-runtime": "^0.x",
    "@eslint/js": "^9.x",
    "eslint": "^9.x",
    "globals": "^15.x",
    "flow-bin": "^0.252.x",
    "flow-typed": "^4.x",
    "mocha": "^10.x",
    "nodemon": "^3.x",
    "supertest": "^6.x"
  },
  "dependencies": {
    "body-parser": "^1.20.x",
    "dotenv": "^16.x",
    "express": "^4.21.x",
    "express-validator": "^7.x",
    "lodash": "^4.17.x",
    "morgan": "^1.10.x",
    "mysql2": "^3.x",
    "sequelize": "^6.x",
    "sequelize-cli": "^6.x"
  }
}
