{
  "name": "express-rest-api-2018",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start:dev": "NODE_ENV=development && yarn db:migrate && nodemon --exec ts-node src/index.ts",
    "start:stg": "NODE_ENV=staging && yarn build && yarn db:migrate && node dist/src/index.js",
    "start:prod": "NODE_ENV=production && yarn build && yarn db:migrate && node dist/src/index.js",
    "docker:build": "docker-compose build",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:stg": "docker-compose -f docker-compose.yml -f docker-compose.stg.yml up",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "db": "sequelize --config config/db.js",
    "db:migrate": "yarn db db:migrate",
    "test": "yarn test:lint && yarn test:unit",
    "test:unit": "yarn mocha 'src/**/*.spec.ts'",
    "test:unit:target": "yarn mocha",
    "test:lint": "eslint ./src/ --ext .ts",
    "mocha": "NODE_ENV=test mocha --require ./mocha-register.js --timeout 20000 --exit"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@types/express": "^4.17.0",
    "@types/lodash": "^4.17.0",
    "@types/mocha": "^10.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "mocha": "^10.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "dotenv": "^5.0.0",
    "express": "^4.16.2",
    "express-validator": "^7.0.0",
    "lodash": "^4.17.5",
    "morgan": "^1.9.0",
    "mysql2": "^1.5.2",
    "sequelize": "^6.37.0",
    "sequelize-cli": "^6.6.0"
  }
}
