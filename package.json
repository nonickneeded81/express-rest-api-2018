{
  "name": "express-rest-api-2018",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start:dev": "NODE_ENV=development && yarn db:migrate && nodemon --exec ts-node src/index.ts",
    "start:stg": "NODE_ENV=staging && yarn build && yarn db:migrate && node dist/index.js",
    "start:prod": "NODE_ENV=production && yarn build && yarn db:migrate && node dist/index.js",
    "docker:build": "docker-compose build",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:stg": "docker-compose -f docker-compose.yml -f docker-compose.stg.yml up",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "db": "sequelize --config config/db.js",
    "db:migrate": "yarn db db:migrate",
    "test": "yarn test:lint && yarn test:unit",
    "test:unit": "yarn mocha 'src/**/*.spec.ts'",
    "test:unit:target": "yarn mocha",
    "test:lint": "eslint ./src/",
    "mocha": "NODE_ENV=test mocha --require ts-node/register --timeout 20000 --exit"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.13",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.14.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.7",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "mysql2": "^2.3.3",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
